    "questions": [
      {
        "id": "22aae908-7847-496a-a6f2-816c7f715bf0",
        "text": {
          "en": "Which document regulates the timeframes for redocumentation for the revision of products in accordance with the MDR, and by when must this revision be completed?",
          "de": "In welchem Dokument sind die Zeiträume der Redokumentationen zur Überarbeitung der Produkte nach MDR geregelt und bis wann muss diese Überarbeitung abgeschlossen sein?"
        },
        "options": [
          {
            "en": "Redocumentation according to MDR is not necessary, so there is no time limit.",
            "de": "Eine Redokumentation nach MDR ist nicht notwendig, daher gibt es auch keine zeitliche Vorgabe."
          },
          {
            "en": "The redocumentation is described in SOP 43.10 and must be completed by 2035.",
            "de": "Die Redokumentation wird in SOP 43.10 beschrieben und muss bis 2035 abgeschlossen sein."
          },
          {
            "en": "The time frame for the MDR redocumentation of MDD projects is described in the Transition Plan. All redocumentation must be completed by the end of 2028.",
            "de": "Der zeitliche Rahmen der MDR Redokumentationen der MDD Projekte ist im Transition Plan beschrieben. Alle Redokumentationen müssen bis Ende 2028 abgeschlossen sein."
          }
        ],
        "correctIndices": [
          2
        ],
        "type": "single"
      }
    ],
