{
  "name": "braingain-backend",
  "private": true,
  "version": "1.5.2",
  "description": "BrainGain backend — Express + TypeScript, JSON file storage",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc && npm run build:assets && npm run sbom",
    "build:assets": "node scripts/copy-assets.mjs",
    "sbom": "cyclonedx-npm --omit dev --mc-type application --output-format JSON --output-reproducible --output-file ../sbom/backend.cdx.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "jwks-rsa": "^4.0.1",
    "nodemailer": "^8.0.11",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  }
}
