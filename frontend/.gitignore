node_modules/
dist/
*.log

# Compiled TS/Vue output must never live in src: Vite resolves .js before .ts, so a stale
# sibling shadows the real source. .ts/.vue are the single source of truth (tsconfig has noEmit).
/src/**/*.js
/vite.config.js

# Playwright e2e artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.server-state.json
